# ═══════════════════════════════════════════════════════
# AI DevOps Auto-Pilot — Environment Configuration
# Copy to .env and update values for your environment
# ═══════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────
APP_NAME=AI DevOps Auto-Pilot
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ── Database (PostgreSQL) ──────────────────────────────
DATABASE_URL=postgresql+asyncpg://autopilot:autopilot@localhost:5432/autopilot
DATABASE_SYNC_URL=postgresql+psycopg2://autopilot:autopilot@localhost:5432/autopilot

# ── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT — CHANGE IN PRODUCTION! ───────────────────────
JWT_SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Docker ─────────────────────────────────────────────
DOCKER_SOCKET=unix:///var/run/docker.sock
CONTAINER_MEMORY_LIMIT=512m
CONTAINER_CPU_LIMIT=0.5
CONTAINER_NETWORK=autopilot-network

# ── Port Allocation ───────────────────────────────────
PORT_RANGE_START=9000
PORT_RANGE_END=9500

# ── Nginx ──────────────────────────────────────────────
NGINX_CONFIG_DIR=/etc/nginx/conf.d
NGINX_RELOAD_CMD=nginx -s reload
BASE_DOMAIN=localhost

# ── Storage ────────────────────────────────────────────
PROJECTS_DIR=/tmp/autopilot/projects
REPOS_DIR=/tmp/autopilot/repos

# ── AI Module (OpenAI-compatible API) ─────────────────
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4

# ── Rate Limiting ─────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Celery ─────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
